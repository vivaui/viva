---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { navigationFor, readCatalog } from '../../../lib/catalog';
import { locales, messages, isLocale, localizePage, componentPath, componentName } from '../../../lib/i18n';

export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error('Unsupported locale');
const text = messages[locale];
const catalog = readCatalog();
const pages = catalog.pages
  .map(page => localizePage(page, locale))
  .sort((left, right) => left.Title.localeCompare(right.Title, 'en'));
---

<DocsLayout {locale} title={text.components} summary={text.componentsSummary} navigation={navigationFor(catalog)} currentID="components" wide>
  <div class="page-heading">
    <h1>{text.components}</h1>
    <p class="page-summary">{text.componentsSummary}</p>
  </div>
  <div class="component-index">
    {pages.map(page => (
      <a class="component-index-link" href={componentPath(locale, page.ID)}>
        <span>{page.Title}</span>
        {locale === 'zh' && <span class="component-index-zh">{componentName(locale, page.ID, page.Title)}</span>}
      </a>
    ))}
  </div>
</DocsLayout>
