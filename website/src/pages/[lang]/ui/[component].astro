---
import { Code } from 'astro:components';
import type { GetStaticPaths } from 'astro';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Preview from '../../../components/Preview.svelte';
import CopyButton from '../../../components/CopyButton.svelte';
import Icon from '../../../components/Icon.svelte';
import { navigationFor, readCatalog } from '../../../lib/catalog';
import { locales, messages, isLocale, localizePage, componentPath, categoryLabel, componentName } from '../../../lib/i18n';

export const getStaticPaths = (() => locales.flatMap(lang => readCatalog().pages.map(page => ({ params: { lang, component: page.ID } })))) satisfies GetStaticPaths;
const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error('Unsupported locale');
const catalog = readCatalog();
const original = catalog.pages.find(entry => entry.ID === Astro.params.component)!;
const page = localizePage(original, locale);
const zhName = locale === 'zh' ? componentName(locale, page.ID, page.Title) : '';
const text = messages[locale];
const themes = { light: 'github-light', dark: 'github-dark' } as const;
const sourceFile = `${page.ID.replaceAll('-', '_')}.go`;
const sourcePath = page.Source || `components/${sourceFile}`;
const sections = page.Sections.filter(section => section.ID !== 'source-ownership');
---

<DocsLayout {locale} title={page.Title} summary={page.Summary} navigation={navigationFor(catalog, page)} currentID={page.ID}>
  <div class="page-heading">
    <div class="breadcrumb"><a href={componentPath(locale)}>{text.components}</a><Icon name="chevron" size={12} /><span>{categoryLabel(locale, page.Category)}</span></div>
    <div class="title-line">
      <h1>{page.Title}{zhName && zhName !== page.Title && <span class="title-zh">{zhName}</span>}</h1>
      <a class="source-link" href={`https://github.com/vivaui/viva/blob/main/${sourcePath}`} target="_blank" rel="noopener noreferrer" aria-label={`${text.viewSource}: ${sourcePath}`}>
        <span>{text.viewSource}</span><code>{sourcePath}</code><Icon name="arrow" size={14} />
      </a>
    </div>
  </div>
  <div class="doc-section">
    {page.Examples.map(example => <section class="example-section" aria-labelledby={`example-${example.ID}`}>
      <h3 id={`example-${example.ID}`}>{example.Title}<a class="heading-anchor" href={`#example-${example.ID}`} aria-label={example.Title}>#</a></h3>
      <p class="example-summary">{example.Description}</p>
      <Preview {locale} componentID={page.ID} title={page.Title} {example} revision={page.Revision} height={example.Height} client:load />
      {example.Snippet && <div class="code-block usage-block">
        <div class="code-toolbar"><span>{text.exampleUsage}</span><CopyButton text={example.Snippet} label={text.copyUsage} {locale} client:load /></div>
        <div class="highlighted-code"><Code code={example.Snippet} lang="go" themes={themes} defaultColor={false} /></div>
      </div>}
    </section>)}
  </div>
  <section class="doc-section" aria-labelledby="installation">
    <h2 id="installation">{text.installation}</h2><p class="section-intro">{page.InstallCommand ? text.installHint : text.installUnavailable}</p>
    {page.InstallCommand && <div class="code-block"><div class="code-toolbar"><span>{text.repositoryCommand}</span><CopyButton text={page.InstallCommand} label={text.copyInstall} {locale} client:load /></div><pre class="source-code command-code" tabindex="0" role="region" aria-label={text.installCommand}><code>{page.InstallCommand}</code></pre></div>}
  </section>
  {sections.map(section => <section class="doc-section prose" aria-labelledby={`section-${section.ID}`}>
    <h2 id={`section-${section.ID}`}>{section.Title}<a class="heading-anchor" href={`#section-${section.ID}`} aria-label={section.Title}>#</a></h2><p>{section.Text}</p>{section.Items && section.Items.length > 0 && <ul>{section.Items.map(item => <li>{item}</li>)}</ul>}
  </section>)}
  <section class="doc-section" aria-labelledby="page-keyboard"><h2 id="page-keyboard">{text.keyboard}</h2><p class="section-intro">{text.keyboardIntro}</p></section>
  <nav slot="toc" aria-label={text.toc}><p class="toc-heading">{text.toc}</p>{page.Examples.map(example => <a class="toc-example" href={`#example-${example.ID}`}>{example.Title}</a>)}<a href="#installation">{text.installation}</a>{sections.map(section => <a href={`#section-${section.ID}`}>{section.Title}</a>)}<a href="#page-keyboard">{text.keyboard}</a></nav>
</DocsLayout>
